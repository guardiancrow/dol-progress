{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DOL Progress Manager",
  "version": "0.4.0",
  "identifier": "com.dolprogress.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DOL Progress Manager",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "connect-src 'self' ipc: http://ipc.localhost https://api.github.com/repos/guardiancrow/dol-progress/releases/latest",
      "devCsp": "connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420 https://api.github.com/repos/guardiancrow/dol-progress/releases/latest"
    }
  },
  "bundle": {
    "active": false,
    "copyright": "Copyright © 2026 guardiancrow",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
